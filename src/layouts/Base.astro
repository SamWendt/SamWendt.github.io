---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/writeups', label: 'Write-ups' },
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eceef1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="logo" href="/"><span class="dot"></span><span class="name">{site.name}</span></a>
        <nav class="nav-links">
          {links.map((l) => <a href={l.href} class={path.startsWith(l.href) ? 'active' : ''}>{l.label}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="wrap">
        <span>{site.name}, {site.location}</span>
        <nav>
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
          <a href={`mailto:${site.email}`}>Email</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
