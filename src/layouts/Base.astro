---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/writeups', label: 'Write-ups' },
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eceef1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="logo" href="/"><span class="dot"></span><span class="name">{site.name}</span></a>
        <nav class="nav-links">
          {links.map((l) => <a href={l.href} class={path.startsWith(l.href) ? 'active' : ''}>{l.label}</a>)}
          <button id="sound" class="sound" type="button" aria-pressed="false">Sound off</button>
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="wrap">
        <span>{site.name}, {site.location}</span>
        <nav>
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
          <a href={`mailto:${site.email}`}>Email</a>
        </nav>
      </div>
    </footer>
    <script>
      import SndLib from 'snd-lib';
      // snd-lib ships as CommonJS; unwrap the default export so it works when bundled
      const Snd: any = (SndLib as any).default ?? SndLib;

      const btn = document.getElementById('sound') as HTMLButtonElement;
      let on = false;
      try { on = localStorage.getItem('sound') === 'on'; } catch {}

      // UI sounds by SND (snd.dev), "sine" kit, free to use. Loaded only when sound is on.
      const snd = new Snd({ easySetup: false });
      let ready: Promise<void> | null = null;
      const load = () => (ready ??= snd.load(Snd.KITS.SND01));
      const play = (fn: () => void) => { if (on) load().then(fn).catch(() => {}); };

      function render() {
        btn.textContent = on ? 'Sound on' : 'Sound off';
        btn.setAttribute('aria-pressed', String(on));
      }
      render();

      btn.addEventListener('click', () => {
        on = !on;
        try { localStorage.setItem('sound', on ? 'on' : 'off'); } catch {}
        render();
        if (on) load().then(() => snd.playToggleOn()).catch(() => {});
        else snd.playToggleOff();
      });

      if (on) load().catch(() => {});

      document.addEventListener('click', (e) => {
        if (!on || e.defaultPrevented) return;
        const t = (e.target as HTMLElement).closest('a, .btn') as HTMLElement | null;
        if (!t || t.id === 'sound') return;
        snd.playButton();
        // let the sound play before an internal link navigates away
        const a = t.closest('a') as HTMLAnchorElement | null;
        const internal = a && a.origin === location.origin && !a.target && !a.hasAttribute('download');
        const modified = (e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey || (e as MouseEvent).button !== 0;
        if (a && internal && !modified && a.href !== location.href) {
          e.preventDefault();
          setTimeout(() => { location.href = a.href; }, 160);
        }
      });

      window.addEventListener('detection', () => play(() => snd.playNotification({ volume: 0.5 })));
    </script>
  </body>
</html>
