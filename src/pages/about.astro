---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const skills = [
  { group: 'Learning now', items: 'Python, SQL, Linux, C' },
  { group: 'Data', items: 'Spark, Hadoop, MongoDB, Power BI, R' },
  { group: 'Security', items: 'pwn.college, Hack The Box, log analysis' },
];
---
<Base title="About">
  <div class="page-head">
    <div class="wrap">
      <h1>About me</h1>
      <p>
        I'm studying Computer Science at Griffith University, majoring in Algorithms &amp; Computing and Data Science &amp; AI.
        I'm focused on the overlap of data engineering and cybersecurity: building pipelines that turn raw security data into something useful.
      </p>
    </div>
  </div>

  <section style="padding-top: 56px;">
    <div class="wrap">
      <div class="section-head"><h2>Skills</h2></div>
      <div class="skills">
        {skills.map((s) => (<div><h3>{s.group}</h3><p>{s.items}</p></div>))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head"><h2>Get in touch</h2></div>
      <p style="color: var(--muted); margin: 0 0 24px;">Open to internships, WIL placements and graduate roles in data or security, based in {site.location}.</p>
      <div class="btns">
        <a class="btn primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn" href={site.github}>GitHub</a>
        <a class="btn" href={site.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>
</Base>
