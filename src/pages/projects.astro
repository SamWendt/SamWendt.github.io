---
import Base from '../layouts/Base.astro';
import ProjectRows from '../components/ProjectRows.astro';
import { projects } from '../data/projects';
---
<Base title="Projects">
  <div class="page-head">
    <div class="wrap">
      <h1>Projects</h1>
      <p>Things I've built or am building, from data pipelines to security labs.</p>
    </div>
  </div>
  <section style="padding-top: 48px;">
    <div class="wrap"><ProjectRows items={projects} /></div>
  </section>
</Base>
