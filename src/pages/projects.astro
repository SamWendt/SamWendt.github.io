---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---
<Base title="Projects">
  <section class="hero" style="padding-bottom: 20px;">
    <p class="kicker">~/projects</p>
    <h1>Projects</h1>
    <p class="lead">Things I've built or am building, from data pipelines to security labs.</p>
  </section>
  <section>
    <div class="grid">
      {projects.map((p) => (
        <div class="card">
          <span class="status">{p.status}</span>
          <h3>{p.link ? <a href={p.link}>{p.title}</a> : p.title}</h3>
          <p>{p.description}</p>
          <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
      ))}
    </div>
  </section>
</Base>
