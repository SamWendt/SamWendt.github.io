---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Write-ups">
  <div class="page-head">
    <div class="wrap">
      <h1>Write-ups</h1>
      <p>Notes from labs, challenges and projects: what I tried, what worked and what I learned.</p>
    </div>
  </div>
  <section style="padding-top: 48px;">
    <div class="wrap"><PostList posts={posts} /></div>
  </section>
</Base>
